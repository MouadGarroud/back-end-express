<file path="useCases/auth/activate.useCase.js">
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import {
  findActivationToken,
  deleteActivationTokenByToken,
} from '../../services/token/Token.service.js';
import {
  activateAccount,
  findUserActivationStatus,
} from '../../services/domain/user.service.js';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import hashToken from '../../utils/hashToken.util.js';

export const activateUseCase = async (rawToken) => {
  try {
    if (!rawToken) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.ACTIVATION_TOKEN_INVALID,
      );
    }

    const hashedToken = hashToken(rawToken);
    const tokenRecord = await findActivationToken(hashedToken);

    if (!tokenRecord) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.ACTIVATION_TOKEN_NOT_FOUND,
      );
    }

    if (tokenRecord.expiresAt.getTime() < Date.now()) {
      await tokenRecord.deleteOne();
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.ACTIVATION_TOKEN_EXPIRED],
        400,
        ERROR_CODES.ACTIVATION_TOKEN_EXPIRED,
      );
    }

    await deleteActivationTokenByToken(hashedToken);
    const user = await findUserActivationStatus(tokenRecord.user);

    if (!user) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        404,
        ERROR_CODES.USER_NOT_FOUND,
      );
    }

    if (user.emailVerified) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.ACCOUNT_ALREADY_ACTIVATED],
        400,
        ERROR_CODES.ACCOUNT_ALREADY_ACTIVATED,
      );
    }

    if (user.status === 'banned') {
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    const activatedUser = await activateAccount(tokenRecord.user);

    return {
      user: activatedUser,
    };
  } catch (error) {
    throw error;
  }
};

export default activateUseCase;
</file>

<file path="useCases/auth/auth.UseCase.js">
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import env from '../../config/env.config.js';
import generateJWT from '../../utils/generateJWT.util.js';
import decodeJWT from '../../utils/decodeJWT.util.js';
import {
  findSessionById,
  logout,
  logoutFromAll,
} from '../../services/JWT/jwt.service.js';
import { findUserWithPasswordById } from '../../services/domain/user.service.js';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';

export const authUseCase = async (token) => {
  try {
    const decoded = decodeJWT(token);

    const { userId, role, sessionId, exp } = decoded;

    if (!userId) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.UESR_ID_INVALID,
      );
    }

    if (!role) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.ROLE_INVALID,
      );
    }

    if (!sessionId) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.SESSION_INVALID,
      );
    }

    const currentTime = Math.floor(Date.now() / 1000);

    if (exp && exp > currentTime) {
      return { accessToken: token, userId, isNew: false };
    }

    const session = await findSessionById(sessionId);

    if (!session) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SESSION_EXPIRED],
        401,
        ERROR_CODES.SESSION_NOT_FOUND,
      );
    }

    if (session.expiresAt.getTime() < Date.now()) {
      await logout(sessionId);
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SESSION_EXPIRED],
        401,
        ERROR_CODES.SESSION_EXPIRED,
      );
    }

    const user = await findUserWithPasswordById(userId);

    if (!user) {
      await logoutFromAll(userId);
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        404,
        ERROR_CODES.USER_NOT_FOUND,
      );
    }

    if (user.status === 'banned') {
      await logout(sessionId);
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      await logout(sessionId);
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    if (user.role !== role) {
      await logout(sessionId);
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        403,
        ERROR_CODES.ROLE_WAS_CHANGE,
      );
    }

    const accessPayload = { userId, role, sessionId };
    const accessExpire = Number(env.JWT_EXPIRES);
    const accessToken = generateJWT(accessPayload, accessExpire);

    return { accessToken, userId, isNew: true };
  } catch (error) {
    throw error;
  }
};

export default authUseCase;
</file>

<file path="useCases/auth/forgetPassword.useCase.js">
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import { findUserByEmail } from '../../services/domain/user.service.js';
import { createResetToken } from '../../services/token/Token.service.js';
import generateRandomToken from '../../utils/generateRandomToken.utils.js';
import { sendTypedMail } from '../../services/mail/mail.service.js';
import TYPE_MAIL from '../../constants/typesMail.constant.js';
import env from '../../config/env.config.js';
import generateJWT from '../../utils/generateJWT.util.js';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';

export const forgetPasswordUseCase = async (email) => {
  try {
    const user = await findUserByEmail(email);

    if (!user) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        404,
        ERROR_CODES.USER_NOT_FOUND,
      );
    }

    if (!user.emailVerified) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.ACCOUNT_NOT_ACTIVATED],
        400,
        ERROR_CODES.ACCOUNT_NOT_ACTIVATED,
      );
    }

    if (user.status === 'banned') {
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    const userId = user._id;
    const role = user.role;
    const userEmail = user.email;
    const expiresAt = Date.now() + Number(env.RESET_TOKEN_EXPIRES) * 1000;
    const length = Number(env.LENGTH_RESET_TOKEN);

    const { rawToken, hashedToken } = generateRandomToken(length);
    const resetToken = await createResetToken(userId, hashedToken, expiresAt);

    const expire = Number(env.JWT_RESEND_EXPIRES);
    const resetTokenId = resetToken._id;
    const payload = { userId, userEmail, role, resetTokenId };

    const resendToken = generateJWT(payload, expire);
    await sendTypedMail({
      type: TYPE_MAIL.RESET,
      to: user.email,
      payload: {
        username: user.username,
        rawToken,
      },
    });

    return { rawToken, resendToken };
  } catch (error) {
    throw error;
  }
};

export default forgetPasswordUseCase;
</file>

<file path="useCases/auth/login.useCase.js">
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import { findUserWithPasswordByEmail } from '../../services/domain/user.service.js';
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import comparePassword from '../../utils/comparePassword.util.js';
import env from '../../config/env.config.js';
import generateJWT from '../../utils/generateJWT.util.js';
import { createSession } from '../../services/JWT/jwt.service.js';

export const loginUseCase = async (data) => {
  try {
    const { ip, email, password, userAgent } = data;

    if (!email) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.EMAIL_REQUIRED],
        409,
        ERROR_CODES.EMAIL_REQUIRED,
      );
    }

    if (!password) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.PASSWORD_REQUIRED],
        409,
        ERROR_CODES.PASSWORD_REQUIRED,
      );
    }

    const user = await findUserWithPasswordByEmail(email);

    if (!user) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        404,
        ERROR_CODES.USER_NOT_FOUND,
      );
    }

    if (!user.emailVerified) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.ACCOUNT_NOT_ACTIVATED],
        400,
        ERROR_CODES.ACCOUNT_NOT_ACTIVATED,
      );
    }

    if (user.status === 'banned') {
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    const isMatch = await comparePassword(password, user.password);
    if (!isMatch) {
      throw new AppError(ERROR_CODES.LOGIN_FAILED, 400);
    }

    const { _id: userId, role } = user;

    const daysToExpire = 30;
    const expiresAt = new Date(Date.now() + daysToExpire * 24 * 60 * 60 * 1000);

    const savedSession = await createSession(userId, userAgent, ip, expiresAt);
    const sessionId = savedSession._id;

    const accessPayload = {
      userId,
      role,
      sessionId,
    };

    const accessExpire = Number(env.JWT_EXPIRES);
    const accessToken = generateJWT(accessPayload, accessExpire);

    return {
      accessToken,
    };
  } catch (error) {
    throw error;
  }
};

export default loginUseCase;
</file>

