<file path="middlewares/auth.middleware.js">
import extractJWT from '../utils/extractJWT.util.js';
import authUseCase from '../useCases/auth/auth.UseCase.js';
import AppError from '../errors/appError.error.js';
import ERROR_CODES from '../constants/errorCodes.constant.js';
import RESPONSE_MESSAGES from '../constants/responseMessages.constant.js';

export const protect = async (req, res, next) => {
  try {
    const token = await extractJWT(req);

    if (!token) {
      return next(
        new AppError(
          RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
          401,
          ERROR_CODES.JWT_INVALID,
        ),
      );
    }

    const { accessToken, userId, isNew } = await authUseCase(token);

    if (isNew) {
      res.setHeader('X-New-Access-Token', accessToken);
      res.setHeader('Access-Control-Expose-Headers', 'X-New-Access-Token');
    }

    req.oldToken = token;
    req.accessToken = accessToken;
    req.userId = userId;

    next();
  } catch (err) {
    next(err);
  }
};

export default protect;
</file>

<file path="middlewares/forgetToken.middleware.js">
import decodeJWT from '../utils/decodeJWT.util.js';
import extractJWT from '../utils/extractJWT.util.js';
import AppError from '../errors/appError.error.js';
import ERROR_CODES from '../constants/errorCodes.constant.js';
import RESPONSE_MESSAGES from '../constants/responseMessages.constant.js';

export const verifyJWTForResend = async (req, res, next) => {
  try {
    const token = extractJWT(req);

    if (!token) {
      return next(
        new AppError(
          ERROR_CODES.UNAUTHORIZED,
          401,
          RESPONSE_MESSAGES[ERROR_CODES.RESET_TOKEN_INVALID],
        ),
      );
    }

    let decodedToken;
    try {
      decodedToken = decodeJWT(token); // Ensure your utility doesn't fail on expiration
    } catch (error) {
      throw error;
    }

    // Your clean, explicit date check logic
    if (decodedToken && decodedToken.exp) {
      const expiresAt = new Date(decodedToken.exp * 1000);

      if (expiresAt.getTime() < Date.now()) {
        return next(
          new AppError(
            ERROR_CODES.TOKEN_EXPIRED,
            402,
            RESPONSE_MESSAGES[ERROR_CODES.TOKEN_EXPIRED],
          ),
        );
      }
    }

    req.body = req.body || {};
    req.body.email = decodedToken.email;

    next();
  } catch (err) {
    next(err);
  }
};
