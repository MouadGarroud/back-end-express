<file path="useCases/auth/resendForgetPassword.useCase.js">
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import { findUserByEmail } from '../../services/domain/user.service.js';
import {
  createResetToken,
  findResetTokenById,
} from '../../services/token/Token.service.js';

import generateRandomToken from '../../utils/generateRandomToken.utils.js';
import { sendTypedMail } from '../../services/mail/mail.service.js';
import TYPE_MAIL from '../../constants/typesMail.constant.js';
import env from '../../config/env.config.js';
import decodeJWT from '../../utils/decodeJWT.util.js';
import { Redis } from '@upstash/redis';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';

export const redisClient = Redis.fromEnv();

export const resendForgetPasswordUseCase = async (token) => {
  try {
    const decoded = decodeJWT(token);

    const { userId, userEmail, role, resetTokenId, exp } = decoded;

    if (!userEmail) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.EMAIL_INVALID,
      );
    }

    if (!role) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.ROLE_INVALID,
      );
    }

    if (!resetTokenId) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.JWT_INVALID,
      );
    }

    const currentTime = Math.floor(Date.now() / 1000);

    if (exp && exp <= currentTime) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.JWT_EXPIRED],
        401,
        ERROR_CODES.JWT_EXPIRED,
      );
    }

    const reset = await findResetTokenById(resetTokenId);

    if (!reset) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.TOKEN_NOT_FOUND,
      );
    }

    const user = await findUserByEmail(userEmail);

    if (!user) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        404,
        ERROR_CODES.USER_NOT_FOUND,
      );
    }

    if (!user.emailVerified) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.ACCOUNT_NOT_ACTIVATED],
        400,
        ERROR_CODES.ACCOUNT_NOT_ACTIVATED,
      );
    }

    if (user.status === 'banned') {
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    if (user.role !== role) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        403,
        ERROR_CODES.ROLE_WAS_CHANGE,
      );
    }

    const expiresAt = Date.now() + Number(env.RESET_TOKEN_EXPIRES) * 1000;
    const length = Number(env.LENGTH_RESET_TOKEN);
    const { rawToken, hashedToken } = generateRandomToken(length);

    await createResetToken(userId, hashedToken, expiresAt);

    await sendTypedMail({
      type: TYPE_MAIL.RESET,
      to: user.email,
      payload: {
        username: user.username,
        rawToken,
      },
    });

    return { rawToken };
  } catch (error) {
    throw error;
  }
};

export default resendForgetPasswordUseCase;
</file>

<file path="useCases/auth/resetPassword.useCase.js">
import AppError from '../../errors/appError.error.js';
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import {
  deleteResetTokenByToken,
  findResetToken,
} from '../../services/token/Token.service.js';
import hashPassword from '../../utils/hashPassword.util.js';
import hashToken from '../../utils/hashToken.util.js';
import {
  resetPasswordByUser,
  findUserWithPasswordById,
} from '../../services/domain/user.service.js';
import comparePassword from '../../utils/comparePassword.util.js';

export const resetPasswordUseCase = async (rawToken, password) => {
  try {
    const hashedToken = hashToken(rawToken);
    const tokenRecord = await findResetToken(hashedToken);

    if (!tokenRecord) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        400,
        ERROR_CODES.RESET_TOKEN_NOT_FOUND,
      );
    }

    if (tokenRecord.expiresAt.getTime() < Date.now()) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.RESET_TOKEN_EXPIRED],
        400,
        ERROR_CODES.RESET_TOKEN_EXPIRED,
      );
    }

    const user = await findUserWithPasswordById(tokenRecord.user);

    if (user.status === 'banned') {
      throw new AppError(RESPONSE_MESSAGES[ERROR_CODES.BANNED], 403, ERROR_CODES.BANNED);
    }

    if (user.status === 'suspended') {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SUSPENDED],
        403,
        ERROR_CODES.SUSPENDED,
      );
    }

    const isMatch = await comparePassword(password, user.password);

    if (isMatch) {
      throw new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.SAME_AS_OLD_PASSWORD],
        400,
        ERROR_CODES.SAME_AS_OLD_PASSWORD,
      );
    }

    const hashedPassword = await hashPassword(password);

    await resetPasswordByUser(tokenRecord.user, hashedPassword);
    await deleteResetTokenByToken(hashedToken);

    return password;
  } catch (error) {
    throw error;
  }
};

export default resetPasswordUseCase;
</file>

