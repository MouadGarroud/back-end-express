<file path="controllers/auth/forgetPassword.controller.js">
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import SUCCESS_CODES from '../../constants/successCodes.constant.js';
import forgetPasswordUseCase from '../../useCases/auth/forgetPassword.useCase.js';

export async function forgetPasswordController(req, res, next) {
  try {
    const email = req.body.email;
    const { rawToken, resendToken } = await forgetPasswordUseCase(email);

    res.status(201).json({
      message: RESPONSE_MESSAGES[SUCCESS_CODES.FORGET_PASSWORD],
      rawToken,
      resendToken,
    });
  } catch (err) {
    next(err);
  }
}

export default forgetPasswordController;
</file>

<file path="controllers/auth/login.controller.js">
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import SUCCESS_CODES from '../../constants/successCodes.constant.js';
import loginUseCase from '../../useCases/auth/login.useCase.js';

export async function loginController(req, res, next) {
  const { email, password } = req.body;

  try {
    const ip = req.ip || null;
    const userAgent = req.headers['user-agent'] || 'Unkown Device';
    const data = { ip, email, password, userAgent };

    const token = await loginUseCase(data);

    res.status(201).json({
      message: RESPONSE_MESSAGES[SUCCESS_CODES.LOGIN],
      token,
    });
  } catch (err) {
    next(err);
  }
}

export default loginController;
</file>

<file path="controllers/auth/logout.controller.js">
import ERROR_CODES from '../../constants/errorCodes.constant.js';
import AppError from '../../errors/appError.error.js';
import RESPONSE_MESSAGES from '../../constants/responseMessages.constant.js';
import SUCCESS_CODES from '../../constants/successCodes.constant.js';
import extractJWT from '../../utils/extractJWT.util.js';
import logoutUseCase from '../../useCases/auth/logout.useCase.js';

export async function logoutController(req, res, next) {
  const token = await extractJWT(req);

  if (!token) {
    return next(
      new AppError(
        RESPONSE_MESSAGES[ERROR_CODES.UNAUTHORIZED],
        401,
        ERROR_CODES.JWT_INVALID,
      ),
    );
  }

  await logoutUseCase(token);
